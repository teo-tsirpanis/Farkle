{
    "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
    "metadata": [
        {
            "src": [
                {
                    "src": "../src",
                    "files": [
                        "**/*.csproj"
                    ]
                }
            ],
            "properties": {
                "TargetFramework": "net9.0"
            },
            "output": "api",
            "disableGitFeatures": false,
            "disableDefaultFilter": false,
            "filter": "filterConfig.yml"
        }
    ],
    "build": {
        "content": [
            {
                "files": [
                    "**/*.md",
                    "api/*.yml",
                    "**/toc.yml"
                ],
                "exclude": [
                    "docs/**/*.md",
                    "_site/**"
                ]
            },
            {
                "files": [
                    "**/*.md",
                    "**/toc.yml"
                ],
                "src": "docs",
                "dest": "."
            },
            {
                "files": [
                    "RELEASE_NOTES.md"
                ],
                "src": "../"
            }
        ],
        "resource": [
            {
                "files": [
                    "CNAME",
                    "docs/*.html",
                    "img/**"
                ]
            }
        ],
        "output": "_site",
        "template": [
            "default",
            "modern",
            "template"
        ],
        "globalMetadata": {
            "_appName": "Farkle",
            "_appTitle": "Farkle",
            "_enableSearch": true,
            "pdf": false
        }
    }
}