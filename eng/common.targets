<Project>
  <PropertyGroup>
    <LangVersion Condition="'$(Language)' == 'C#'">15</LangVersion>
  </PropertyGroup>
  <ItemGroup Condition="$(ExcludeFromCodeCoverage) == true">
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute" />
  </ItemGroup>
  <Import Condition="$(PatchNuspecDependencies) == true" Project="$(MSBuildThisFileDirectory)patch-nuspec.targets" />
</Project>
