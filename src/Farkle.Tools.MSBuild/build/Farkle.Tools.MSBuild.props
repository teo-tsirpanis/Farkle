<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <SigourneyRegisteredTargets>$(SigourneyRegisteredTargets);FarkleRunPrecompiler</SigourneyRegisteredTargets>
  </PropertyGroup>

  <Choose>
    <When Condition="$(MSBuildRuntimeType) == Core OR ('$(MSBuildVersion)' != '' AND $([System.Version]::Parse($(MSBuildVersion)).Major) &gt;= 18)">
      <PropertyGroup>
        <FarkleTaskAssembly>$(MSBuildThisFileDirectory)../tools/net8.0/Farkle.Tools.MSBuild.dll</FarkleTaskAssembly>
        <FarklePrecompilerTaskRuntime>NET</FarklePrecompilerTaskRuntime>
      </PropertyGroup>
    </When>
    <Otherwise>
      <PropertyGroup>
        <FarkleTaskAssembly>$(MSBuildThisFileDirectory)../tools/netstandard2.0/Farkle.Tools.MSBuild.dll</FarkleTaskAssembly>
      </PropertyGroup>
    </Otherwise>
  </Choose>
</Project>
