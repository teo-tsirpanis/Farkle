{{~include "builtin://Navigation"
func join_and(items, sep, last_sep)
    res = ""
    for $x in items
        res = res + $x
        case for.rindex
            when 0
            when 1
                res = res + last_sep
            else
                res = res + sep
        end
    end
    ret res
end
~}}
<main>
    <h1>{{if is_conflict_report; "Conflict report for "; end}}{{html.escape grammar_name}}</h1>
    {{~ if is_conflict_report ~}}
    <div id="conflicts" class="flex-container">
        {{~ if !no_lalrstates && grammar.lr_state_machine.has_conflicts
            has_conflicts(state) = state.has_conflicts;
            $conflicted_lr_states = grammar.lr_state_machine | array.filter @has_conflicts | array.map "state_index";
            $state_states = string.pluralize (array.size $conflicted_lr_states) "state" "states";
            $has_have = string.pluralize (array.size $conflicted_lr_states) "has" "have"; ~}}
        <section id="lr-conflicts">
            <p><strong>{{ array.size $conflicted_lr_states }}</strong> LALR {{ $state_states }} {{ $has_have }} conflicts:</p>
            <ul>
                {{~ for conflict in $conflicted_lr_states ~}}
                <li><a href="#lalr{{ conflict }}">State {{ conflict }}</a></li>
                {{~ end ~}}
            </ul>
        </section>
        {{~ end ~}}
        {{~ if !no_dfastates && grammar.dfa_on_char.has_conflicts
            has_conflicts(state) = state.has_conflicts;
            $conflicted_dfa_states = grammar.dfa_on_char | array.filter @has_conflicts | array.map "state_index";
            $state_states = string.pluralize (array.size $conflicted_dfa_states) "state" "states";
            $has_have = string.pluralize (array.size $conflicted_dfa_states) "has" "have"; ~}}
        <section id="dfa-conflicts">
            <p><strong>{{ array.size $conflicted_dfa_states }}</strong> DFA {{ $state_states }} {{ $has_have }} conflicts:</p>
            <ul>
                {{~ for conflict in $conflicted_dfa_states ~}}
                <li><a href="#dfa{{ conflict }}">State {{ conflict }}</a></li>
                {{~ end ~}}
            </ul>
        </section>
        {{~ end ~}}
    </div>
    {{~ end ~}}
    <section id="properties">
        <h2>Properties</h2>
        {{~
        $misc_symbol_count = (array.size grammar.token_symbols) - (array.size grammar.terminals)
        $grammar_items = [
            (array.size grammar.terminals) + string.pluralize (array.size grammar.terminals) " terminal" " terminals",
            (array.size grammar.nonterminals) + string.pluralize (array.size grammar.nonterminals) " nonterminal" " nonterminals",
            (array.size grammar.productions) + string.pluralize (array.size grammar.productions) " production" " productions"
        ]
        if $misc_symbol_count > 0
            $grammar_items = $grammar_items + [
                $misc_symbol_count + string.pluralize $misc_symbol_count " miscellaneous symbol" " miscellaneous symbols"
            ]
        end
        if grammar.lr_state_machine != null
            $grammar_items = $grammar_items + [
                (array.size grammar.lr_state_machine) + " LR states"
            ]
        end
        if grammar.dfa_on_char != null
            $grammar_items = $grammar_items + [
                (array.size grammar.dfa_on_char) + " DFA " + string.pluralize (array.size grammar.dfa_on_char) "state" "states"
            ]
        end
        ~}}
        <p>The grammar has {{ join_and $grammar_items ", " " and " }}.</p>
    </section>
    {{~include "builtin://Syntax" grammar.nonterminals~}}
    {{~if !grammar.groups.empty?; include "builtin://Groups" grammar.groups; end~}}
    {{~if !no_lalrstates; include "builtin://LALRStates" grammar.lr_state_machine; end~}}
    {{~if !no_dfastates; include "builtin://DFAStates" grammar.dfa_on_char; end~}}
</main>
