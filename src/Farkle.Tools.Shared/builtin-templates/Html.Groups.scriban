<section id="groups">
    <h2>Groups</h2>
    <ul>
        {{~for $group in $1~}}
        <li id="g{{for.index}}">
            <h3>{{html.escape $group.name}}</h3>
            <dl>
                <dt>Container Symbol</dt>
                {{~if is_terminal $group.container.attributes~}}
                <dd class="group-container-terminal">{{html.escape $group.container.name}}</dd>
                {{~else~}}
                <dd class="group-container-noise">{{html.escape $group.container.name}} (Noise)</dd>
                {{~end~}}

                <dt>Starts with</dt>
                <dd class="group-start">{{html.escape $group.start.name}}</dd>

                <dt>Ends with</dt>
                <dd class="group-end">{{html.escape $group.end.name}}</dd>

                <dt>Inside the group the tokenizer advances by</dt>
                <dd>{{is_advance_by_character $group.attributes ? "Character" : "Token"}}</dd>

                <dt>When the group ends the end token is</dt>
                <dd>{{is_keep_end_token $group.attributes ? "Kept" : "Discarded"}}</dd>

                <dt>The group also ends on end of input</dt>
                <dd>{{is_ends_on_end_of_input $group.attributes ? "Yes" : "No"}}</dd>

                {{~if !$group.nesting.empty?~}}
                <dt>Can be nested with</dt>
                <dd>
                    <ul class="group-nesting">
                        {{~for $g in $group.nesting~}}
                        <li><a href="#g{{$g.handle.value}}">{{html.escape $g.name}}</a></li>
                        {{~end~}}
                    </ul>
                </dd>
                {{~end~}}
            </dl>
        </li>
    {{~end~}}
    </ul>
</section>
