{{~file_extension = '.html'
grammar_name = grammar.grammar_info.name
# The no_ variables are specified by the user. Update them to account for the state machine not existing.
no_lalrstates = no_lalrstates || grammar.lr_state_machine == null
no_dfastates = no_dfastates || grammar.dfa_on_char == null~}}
<!DOCTYPE html>
<html lang="en"{{if is_conflict_report}} class="conflict-report"{{end}}>
    <head>
        <meta charset="utf-8">
        <meta name="description" content="Auto-generated documentation of the {{attr_escape grammar_name}} grammar.">
        <meta name="generator" content="Farkle version {{attr_escape farkle.version}}">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{{html.escape grammar_name}}{{if is_conflict_report; " - Conflict Report"; end}}</title>
        {{~if !no_css~}}
        <style>
        {{~include "builtin://Style"~}}
        </style>
        {{~end~}}
        {{~custom_head~}}
    </head>
    <body>
    {{~include "builtin://Grammar"~}}
    <footer>
        <p>This page was automatically generated by <a href="https://teo-tsirpanis.github.io/Farkle">
        <abbr title="FArkle Recognizes Known Languages Easily">Farkle</abbr> version
        {{html.escape farkle.version}}</a>.</p>
    </footer>
    </body>
</html>
