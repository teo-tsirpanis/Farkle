<section id="syntax">
    <h2>Syntax</h2>
    <ul>
        {{~for $nont in $1~}}
        <li id="n{{for.index}}">
            <span class="nonterminal">{{html.escape $nont.name}}</span>
            <ul class="productions">
                {{~for $prod in $nont.productions~}}
                <li id="prod{{$prod.handle.value}}" >
                    <ol class="production-handle">
                        {{~for $sym in $prod.members
                            $sym_extracted = grammar.get_object_from_handle $sym~}}
                        <li>
                            {{-if $sym.is_token_symbol-}}
                            <span class="terminal">{{html.escape $sym_extracted.name}}</span>
                            {{-else-}}
                            <a class="nonterminal" href="#n{{$sym_extracted.handle.value}}">{{html.escape $sym_extracted.name}}</a>
                            {{-end-}}
                        </li>
                        {{~end~}}
                        {{~if $prod.members.empty?
                            # Writing a "Nothing" using CSS will not work because the
                            # :empty selector is tarnation useless and cannot match
                            # <ol>
                            # </ol> because of the new line!~}}
                        <li class="production-empty">Nothing</li>
                        {{~end~}}
                    </ol>
                </li>
                {{~end~}}
            </ul>
        </li>
        {{~end~}}
    </ul>
</section>
